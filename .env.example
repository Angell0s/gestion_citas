# ==========================================
# CONFIGURACIÓN GENERAL DEL PROYECTO
# ==========================================

# Nombre y versión de la API (se muestran en /docs)
PROJECT_NAME="Sistema de Citas"
PROJECT_VERSION="0.1.0"

# Entorno: development | testing | production
ENVIRONMENT="development"

# Modo debug (true/false) - en producción siempre false
DEBUG="false"

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================

# Credenciales para el contenedor de PostgreSQL (usadas por Docker Compose)
# También se usan para construir DATABASE_URL si no la defines directamente
POSTGRES_USER="admin"
POSTGRES_PASSWORD="micontraseña"
POSTGRES_DB="gestion_citas"

# Opción 1: Cadena de conexión completa (recomendada)
# Puedes usar las variables POSTGRES_* para construirla:
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"
DATABASE_URL="postgresql://admin:micontraseña@db:5432/gestion_citas"

# Opción 2: Variables separadas (fallback si DATABASE_URL no está definida)
# Útiles si prefieres que la app construya la URL internamente
DB_HOST="db"
DB_PORT=5432

# ==========================================
# SEGURIDAD Y JWT (¡IMPORTANTE!)
# ==========================================

# Clave secreta para firmar JWT - ¡OBLIGATORIA!
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY="cambia_esto_por_una_clave_segura_de_64_caracteres"

# Algoritmo de firma (HS256 es el más común)
JWT_ALGORITHM="HS256"

# Tiempo de expiración por defecto (minutos) - se usa como fallback
JWT_EXPIRE_MINUTES=60

# Tiempos específicos para "recordarme" y sesión normal (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080   # 7 días
ACCESS_TOKEN_EXPIRE_MINUTES_DEFAULT=60       # 1 hora